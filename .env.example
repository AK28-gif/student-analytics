# Copy to .env and adjust. Never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_db
DB_USER=student_app
DB_PASSWORD=change_me

# Optional overrides
# UCI_DATASET_URL=https://archive.ics.uci.edu/static/public/320/student+performance.zip
# UCI_LOCAL_ZIP=/path/to/student+performance.zip   # offline mode
# SESSIONS_PER_YEAR=120
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# API_URL=http://localhost:8000

# Optional pip mirror used by the Docker build (if PyPI is blocked on your network)
# PIP_INDEX_URL=https://pypi.org/simple
